diff --git a/arch/arm/vdso/vgettimeofday.c b/arch/arm/vdso/vgettimeofday.c
index 3eebeddbf..4fb0ec780 100644
--- a/arch/arm/vdso/vgettimeofday.c
+++ b/arch/arm/vdso/vgettimeofday.c
@@ -1,21 +1,130 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /*
- * ARM userspace implementations of gettimeofday() and similar.
+ * ARM userspace implementations of gettimeofday() and KML vDSO wrappers.
  *
  * Copyright 2015 Mentor Graphics Corporation.
  */
 #include <linux/time.h>
 #include <linux/types.h>
+#include <uapi/asm-generic/errno.h>
+#include <asm/unistd.h>
 #include <asm/vdso.h>
 #include <asm/unwind.h>
+#include <vdso/datapage.h>
 #include <vdso/gettime.h>
 
+#ifdef CONFIG_KERNEL_MODE_LINUX
+long __vdso_kml_syscall(long nr, unsigned long a0, unsigned long a1,
+			unsigned long a2, unsigned long a3, unsigned long a4,
+			unsigned long a5);
+int __vdso_sched_yield(void);
+int __vdso_nanosleep(const struct __kernel_timespec *req,
+		     struct __kernel_timespec *rem);
+signed long __vdso_kernel_sched_timeout(signed long timeout);
+long __vdso_trace_call_by_kml(void);
+#endif
+
+#ifdef CONFIG_KERNEL_MODE_LINUX
+static __always_inline bool arm_kml_system_mode(void)
+{
+	unsigned long cpsr;
+
+	asm("mrs %0, cpsr" : "=r" (cpsr));
+	return (cpsr & 0xf) == 0xf;
+}
+
+static __always_inline unsigned long arm_get_syscall_addr(unsigned int nr)
+{
+	const unsigned long *table;
+
+	if (nr >= __NR_syscalls)
+		return 0;
+	table = (const unsigned long *)(unsigned long)vdso_u_time_data.kml_sys_call_table;
+	if (!table)
+		return 0;
+	return table[nr];
+}
+
+long __vdso_kml_syscall(long nr, unsigned long a0, unsigned long a1,
+			unsigned long a2, unsigned long a3, unsigned long a4,
+			unsigned long a5)
+{
+	unsigned long addr;
+
+	if (!arm_kml_system_mode())
+		return -EPERM;
+	addr = arm_get_syscall_addr((unsigned int)nr);
+	if (!addr)
+		return -ENOSYS;
+	return ((long (*)(unsigned long, unsigned long, unsigned long,
+			  unsigned long, unsigned long, unsigned long))addr)(
+		a0, a1, a2, a3, a4, a5);
+}
+long kml_syscall(long nr, unsigned long a0, unsigned long a1,
+		 unsigned long a2, unsigned long a3, unsigned long a4,
+		 unsigned long a5)
+	__attribute__((weak, alias("__vdso_kml_syscall")));
+
+int __vdso_sched_yield(void)
+{
+	if (arm_kml_system_mode())
+		return (int)__vdso_kml_syscall(__NR_sched_yield, 0, 0, 0, 0, 0, 0);
+	return -EPERM;
+}
+int sched_yield(void) __attribute__((weak, alias("__vdso_sched_yield")));
+
+int __vdso_nanosleep(const struct __kernel_timespec *req,
+		     struct __kernel_timespec *rem)
+{
+	if (arm_kml_system_mode())
+		return (int)__vdso_kml_syscall(__NR_clock_nanosleep_time64,
+					       CLOCK_MONOTONIC, 0,
+					       (unsigned long)req,
+					       (unsigned long)rem, 0, 0);
+	return -EPERM;
+}
+int nanosleep(const struct __kernel_timespec *req,
+	      struct __kernel_timespec *rem)
+	__attribute__((weak, alias("__vdso_nanosleep")));
+
+signed long __vdso_kernel_sched_timeout(signed long timeout)
+{
+	unsigned long fn = (unsigned long)vdso_u_time_data.kml_sched_timeout;
+
+	if (!arm_kml_system_mode() || !fn)
+		return -EPERM;
+	return ((signed long (*)(signed long))fn)(timeout);
+}
+signed long kernel_sched_timeout(signed long timeout)
+	__attribute__((weak, alias("__vdso_kernel_sched_timeout")));
+
+long __vdso_trace_call_by_kml(void)
+{
+	unsigned long fn = (unsigned long)vdso_u_time_data.kml_trace_call;
+
+	if (!arm_kml_system_mode() || !fn)
+		return -EPERM;
+	((void (*)(void))fn)();
+	return 0;
+}
+long trace_call_by_kml(void)
+	__attribute__((weak, alias("__vdso_trace_call_by_kml")));
+#endif /* CONFIG_KERNEL_MODE_LINUX */
+
 #ifdef CONFIG_COMPAT_32BIT_TIME
 int __vdso_clock_gettime(clockid_t clock,
 			 struct old_timespec32 *ts)
 {
+#ifdef CONFIG_KERNEL_MODE_LINUX
+	if (arm_kml_system_mode())
+		return (int)__vdso_kml_syscall(__NR_clock_gettime,
+					       (unsigned long)clock,
+					       (unsigned long)ts, 0, 0, 0, 0);
+#endif
 	return __cvdso_clock_gettime32(clock, ts);
 }
+int clock_gettime(clockid_t clock, struct old_timespec32 *ts)
+	__attribute__((weak, alias("__vdso_clock_gettime")));
 
 int __vdso_clock_getres(clockid_t clock_id,
 			struct old_timespec32 *res)
@@ -26,13 +135,27 @@ int __vdso_clock_getres(clockid_t clock_id,
 int __vdso_gettimeofday(struct __kernel_old_timeval *tv,
 			struct timezone *tz)
 {
+#ifdef CONFIG_KERNEL_MODE_LINUX
+	if (arm_kml_system_mode())
+		return (int)__vdso_kml_syscall(__NR_gettimeofday,
+					       (unsigned long)tv,
+					       (unsigned long)tz, 0, 0, 0, 0);
+#endif
 	return __cvdso_gettimeofday(tv, tz);
 }
+int gettimeofday(struct __kernel_old_timeval *tv, struct timezone *tz)
+	__attribute__((weak, alias("__vdso_gettimeofday")));
 #endif /* CONFIG_COMPAT_32BIT_TIME */
 
 int __vdso_clock_gettime64(clockid_t clock,
 			   struct __kernel_timespec *ts)
 {
+#ifdef CONFIG_KERNEL_MODE_LINUX
+	if (arm_kml_system_mode())
+		return (int)__vdso_kml_syscall(__NR_clock_gettime64,
+					       (unsigned long)clock,
+					       (unsigned long)ts, 0, 0, 0, 0);
+#endif
 	return __cvdso_clock_gettime(clock, ts);
 }
 
diff --git a/arch/x86/entry/entry_64.S b/arch/x86/entry/entry_64.S
index de0fc580b..21bed7a06 100644
--- a/arch/x86/entry/entry_64.S
+++ b/arch/x86/entry/entry_64.S
@@ -1553,6 +1553,72 @@ SYM_CODE_START_NOALIGN(rewind_stack_and_make_dead)
 SYM_CODE_END(rewind_stack_and_make_dead)
 .popsection
 
+#ifdef CONFIG_KERNEL_MODE_LINUX
+/*
+ * Direct Ring-0 kernel call entry from KML user space (invoked via vDSO).
+ * %rdi: pointer to struct kml_call_args on caller stack.
+ *
+ * Switches from user GSBASE + user RSP to kernel GSBASE + current's kernel
+ * stack (below task_pt_regs(current)) with zero privilege-level traps, invokes
+ * __kml_trampoline(), and restores user RSP + user GSBASE before returning.
+ */
+.pushsection .text, "ax"
+SYM_FUNC_START(kml_trampoline)
+	ENDBR
+	testq	%rsp, %rsp
+	js	.Lkml_already_kstack
+
+	pushq	%rbp
+	pushq	%rbx
+	pushfq
+	popq	%rbx			/* Save caller RFLAGS in callee-saved %rbx */
+	movq	%rsp, %rbp		/* Save caller user RSP in callee-saved %rbp */
+
+	cli
+	swapgs
+	movq	PER_CPU_VAR(cpu_current_top_of_stack), %rsp
+	subq	$PTREGS_SIZE, %rsp
+	andq	$-16, %rsp
+	/*
+	 * Switch %cs from __KML_CS to __KERNEL_CS while executing inside the
+	 * kernel so context switches (__switch_to_asm) neither leak __KML_CS
+	 * to another task on this CPU nor lose __KML_CS if this task migrates
+	 * to another CPU.
+	 */
+	pushq	$__KERNEL_CS
+	leaq	.Lkml_in_kernel_cs(%rip), %rax
+	pushq	%rax
+	lretq
+.Lkml_in_kernel_cs:
+	ANNOTATE_NOENDBR
+	sti
+
+	call	__kml_trampoline
+
+	cli
+	pushq	$__KML_CS
+	leaq	.Lkml_back_to_kml_cs(%rip), %rcx
+	pushq	%rcx
+	lretq
+.Lkml_back_to_kml_cs:
+	ANNOTATE_NOENDBR
+	swapgs
+	movq	%rbp, %rsp
+	testl	$X86_EFLAGS_IF, %ebx
+	jz	1f
+	sti
+1:
+	popq	%rbx
+	popq	%rbp
+	RET
+
+.Lkml_already_kstack:
+	jmp	__kml_trampoline
+SYM_FUNC_END(kml_trampoline)
+STACK_FRAME_NON_STANDARD(kml_trampoline)
+.popsection
+#endif
+
 /*
  * This sequence executes branches in order to remove user branch information
  * from the branch history tracker in the Branch Predictor, therefore removing
diff --git a/arch/x86/entry/syscall_64.c b/arch/x86/entry/syscall_64.c
index 472a53e55..94d0a3363 100644
--- a/arch/x86/entry/syscall_64.c
+++ b/arch/x86/entry/syscall_64.c
@@ -7,6 +7,7 @@
 #include <linux/syscalls.h>
 #include <linux/entry-common.h>
 #include <linux/nospec.h>
+#include <linux/kml.h>
 #include <asm/syscall.h>
 
 #define __SYSCALL(nr, sym) extern long __x64_##sym(const struct pt_regs *);
@@ -134,3 +135,40 @@ __visible noinstr bool do_syscall_64(struct pt_regs *regs, long nr)
 	/* Use SYSRET to exit to userspace */
 	return true;
 }
+
+#ifdef CONFIG_KERNEL_MODE_LINUX
+typedef long (*kml_fn_t)(unsigned long, unsigned long, unsigned long,
+			 unsigned long, unsigned long, unsigned long);
+
+asmlinkage __visible long __kml_trampoline(const struct kml_call_args *uargs)
+{
+	struct kml_call_args args = *uargs;
+
+	if (args.is_syscall) {
+		unsigned long nr = args.fn_or_nr;
+		struct pt_regs regs = {
+			.di = args.a0,
+			.si = args.a1,
+			.dx = args.a2,
+			.r10 = args.a3,
+			.r8 = args.a4,
+			.r9 = args.a5,
+			.orig_ax = nr,
+			.ax = -ENOSYS,
+			.cs = __KML_CS,
+			.ss = __KERNEL_DS,
+		};
+
+		if (unlikely(nr >= NR_syscalls))
+			return -ENOSYS;
+		nr = array_index_nospec(nr, NR_syscalls);
+		return x64_sys_call(&regs, (unsigned int)nr);
+	}
+
+	if (unlikely(!args.fn_or_nr))
+		return -EINVAL;
+
+	return ((kml_fn_t)args.fn_or_nr)(args.a0, args.a1, args.a2,
+					 args.a3, args.a4, args.a5);
+}
+#endif
