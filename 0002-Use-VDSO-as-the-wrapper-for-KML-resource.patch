diff --git a/arch/x86/entry/vdso/vdso64/vkml.c b/arch/x86/entry/vdso/vdso64/vkml.c
new file mode 100644
index 000000000..811c1bb4f
--- /dev/null
+++ b/arch/x86/entry/vdso/vdso64/vkml.c
@@ -0,0 +1,150 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * x86_64 vDSO wrappers for Kernel Mode Linux (KML) direct kernel calls.
+ */
+
+#include <linux/types.h>
+#include <uapi/linux/time.h>
+#include <uapi/asm-generic/errno.h>
+#include <asm/unistd.h>
+#include <vdso/datapage.h>
+
+long __vdso_kml_syscall(long nr, unsigned long a0, unsigned long a1,
+			unsigned long a2, unsigned long a3, unsigned long a4,
+			unsigned long a5);
+long __vdso_kml_call(unsigned long fn, unsigned long a0, unsigned long a1,
+		     unsigned long a2, unsigned long a3, unsigned long a4,
+		     unsigned long a5);
+int __vdso_sched_yield(void);
+int __vdso_nanosleep(const struct __kernel_timespec *req,
+		     struct __kernel_timespec *rem);
+signed long __vdso_kernel_sched_timeout(signed long timeout);
+long __vdso_trace_call_by_kml(void);
+
+static __always_inline bool kml_in_ring0(void)
+{
+	u16 cs;
+
+	asm("mov %%cs, %0" : "=r" (cs));
+	return (cs & 3) == 0;
+}
+
+static __always_inline long kml_trampoline_invoke(u64 fn_or_nr, u64 is_syscall,
+						  u64 a0, u64 a1, u64 a2,
+						  u64 a3, u64 a4, u64 a5)
+{
+	const struct vdso_time_data *vdata = &vdso_u_time_data;
+	long (*entry)(const struct kml_call_args *args);
+	struct kml_call_args args = {
+		.fn_or_nr = fn_or_nr,
+		.a0 = a0,
+		.a1 = a1,
+		.a2 = a2,
+		.a3 = a3,
+		.a4 = a4,
+		.a5 = a5,
+		.is_syscall = is_syscall,
+	};
+
+	entry = (void *)(unsigned long)vdata->kml_trampoline;
+	if (!entry)
+		return -ENOSYS;
+
+	return entry(&args);
+}
+
+static __always_inline long vdso_ring3_syscall2(long nr, unsigned long a0,
+						unsigned long a1)
+{
+	long ret;
+
+	asm volatile("syscall"
+		     : "=a" (ret)
+		     : "0" (nr), "D" (a0), "S" (a1)
+		     : "rcx", "r11", "memory");
+	return ret;
+}
+
+long __vdso_kml_syscall(long nr, unsigned long a0, unsigned long a1,
+			unsigned long a2, unsigned long a3, unsigned long a4,
+			unsigned long a5)
+{
+	if (!kml_in_ring0())
+		return -EPERM;
+
+	return kml_trampoline_invoke((u64)nr, 1, a0, a1, a2, a3, a4, a5);
+}
+long kml_syscall(long nr, unsigned long a0, unsigned long a1,
+		 unsigned long a2, unsigned long a3, unsigned long a4,
+		 unsigned long a5)
+	__attribute__((weak, alias("__vdso_kml_syscall")));
+
+long __vdso_kml_call(unsigned long fn, unsigned long a0, unsigned long a1,
+		     unsigned long a2, unsigned long a3, unsigned long a4,
+		     unsigned long a5)
+{
+	if (!kml_in_ring0())
+		return -EPERM;
+
