 	return __cvdso_gettimeofday(tv, tz);
 }
 
@@ -37,6 +57,12 @@ __kernel_old_time_t time(__kernel_old_time_t *t)	__attribute__((weak, alias("__v
 /* both 64-bit and x32 use these */
