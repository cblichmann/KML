 	return regs;
 }
 
+#ifdef CONFIG_KERNEL_MODE_LINUX
+asmlinkage __visible noinstr struct pt_regs *kml_switch_off_ist(struct pt_regs *eregs)
+{
+	struct cea_exception_stacks *cea = __this_cpu_read(cea_exception_stacks);
+	unsigned long top, bot, frame_size;
+	void *dst;
+
+	if (!cea)
+		return eregs;
+
+	top = CEA_ESTACK_TOP(cea, KML);
+	bot = CEA_ESTACK_BOT(cea, KML);
+	if ((unsigned long)eregs < bot || (unsigned long)eregs >= top)
+		return eregs;
+	if (eregs->sp >= bot && eregs->sp <= top)
+		return eregs;
+
+	frame_size = top - (unsigned long)eregs;
+	dst = (void *)(eregs->sp - frame_size);
+	__memcpy(dst, eregs, frame_size);
+	return (struct pt_regs *)dst;
+}
+#endif
