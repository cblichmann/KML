+config KERNEL_MODE_LINUX
+	bool "Kernel Mode Linux"
+	help
+	  This enables Kernel Mode Linux. In Kernel Mode Linux, trusted user
+	  programs can be executed in kernel mode (CPU Ring 0 on x86_64, EL1t
+	  on AArch64, or SYSTEM_MODE on ARM) and access kernel address space
+	  directly. Thus, costly privilege-level switches between user mode and
+	  kernel mode can be eliminated for real-time or latency-critical
+	  workloads.
+
+	  More information about Kernel Mode Linux can be found in
+	  <file:Documentation/admin-guide/kml.rst>.
+
