index bba83228b..c8414a6a7 100644
--- a/arch/arm/include/asm/processor.h
+++ b/arch/arm/include/asm/processor.h
@@ -49,6 +49,14 @@ static inline void arch_thread_struct_whitelist(unsigned long *offset,
 
 #define INIT_THREAD  {	}
 
+#ifdef CONFIG_KERNEL_MODE_LINUX
+#define clear_thread_flag_ku()	clear_thread_flag(TIF_KU)
+#define set_thread_flag_ku()	set_thread_flag(TIF_KU)
+#else
+#define clear_thread_flag_ku()	do { } while (0)
+#define set_thread_flag_ku()	do { } while (0)
+#endif
+
 #define start_thread(regs,pc,sp)					\
 ({									\
 	unsigned long r7, r8, r9;					\
@@ -77,7 +85,28 @@ static inline void arch_thread_struct_whitelist(unsigned long *offset,
 		regs->ARM_cpsr |= PSR_E_BIT;				\
 	regs->ARM_pc = pc & ~1;		/* pc */			\
 	regs->ARM_sp = sp;		/* sp */			\
+	clear_thread_flag_ku();						\
+})
+
+#ifdef CONFIG_KERNEL_MODE_LINUX
+#define start_kernel_thread(regs,pc,sp)					\
+({									\
+	memset(regs->uregs, 0, sizeof(regs->uregs));			\
+	if (!IS_ENABLED(CONFIG_MMU))					\
+		regs->ARM_r10 = current->mm->start_data;		\
+	if (current->personality & ADDR_LIMIT_32BIT)			\
+		regs->ARM_cpsr = SYSTEM_MODE;				\
+	else								\
+		regs->ARM_cpsr = USR26_MODE;				\
+	if (elf_hwcap & HWCAP_THUMB && pc & 1)				\
+		regs->ARM_cpsr |= PSR_T_BIT;				\
+	if (IS_ENABLED(CONFIG_CPU_ENDIAN_BE8))				\
+		regs->ARM_cpsr |= PSR_E_BIT;				\
+	regs->ARM_pc = pc & ~1;		/* pc */			\
+	regs->ARM_sp = sp;		/* sp */			\
+	set_thread_flag_ku();						\
 })
+#endif
 
 /* Forward declaration, a strange C thing */
 struct task_struct;
